digraph Estructura {
    graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.28", ranksep="0.60", splines=polyline,
        fontname="DejaVu Sans", fontsize=24, labelloc=t, label="REGISTRO DE SINIESTROS\nEstructura del proyecto", dpi=150];
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=15, margin="0.20,0.15",
        color="#d8dee8", penwidth=1.1, fillcolor="#f8fafc", fontcolor="#172033"];
    edge [color="#8c98aa", penwidth=1.2, arrowsize=0.65];
    proyecto [label="RegistroSiniestros", fillcolor="#172033", fontcolor="white", color="#172033", fontsize=18];
    entrada [label="Entrada", fillcolor="#fff1f0", color="#efcccc", fontcolor="#9b1c1c"];
    mvc [label="MVC", fillcolor="#fff1f0", color="#efcccc", fontcolor="#9b1c1c"];
    apoyo [label="Apoyo", fillcolor="#fff1f0", color="#efcccc", fontcolor="#9b1c1c"];
    datos [label="Datos", fillcolor="#fff1f0", color="#efcccc", fontcolor="#9b1c1c"];
    inicio [label="index.php\nEnrutamiento y sesión"];
    config [label="config.php\nConexión y URL base"];
    controladores [label="controllers/\nSolicitudes y acciones"];
    modelos [label="models/\nConsultas y persistencia"];
    vistas [label="views/\nPantallas y componentes"];
    librerias [label="lib/\nSeguridad y validaciones"];
    recursos [label="assets/\nCSS, JavaScript e imágenes"];
    pruebas [label="pruebas/\nComprobaciones auxiliares"];
    sql [label="z database/\nEsquema y objetos SQL"];
    archivos [label="uploads/\nArchivos locales heredados"];
    proyecto -> entrada;
    proyecto -> mvc;
    proyecto -> apoyo;
    proyecto -> datos;
    entrada -> inicio;
    entrada -> config;
    mvc -> controladores;
    mvc -> modelos;
    mvc -> vistas;
    apoyo -> librerias;
    apoyo -> recursos;
    apoyo -> pruebas;
    datos -> sql;
    datos -> archivos;
}
