digraph MVC {
    graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.55", splines=polyline,
        fontname="DejaVu Sans", fontsize=24, labelloc=t, label="REGISTRO DE SINIESTROS\nArquitectura MVC", dpi=150];
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=15, margin="0.20,0.15",
        color="#d8dee8", penwidth=1.1, fillcolor="#f8fafc", fontcolor="#172033"];
    edge [color="#8c98aa", penwidth=1.2, arrowsize=0.65];
    peticion [label="Petición del navegador", fillcolor="#172033", fontcolor="white", color="#172033"];
    entrada [label="index.php\nEnrutamiento y sesión"];
    controlador [label="Controlador\nAutoriza y coordina", fillcolor="#fff1f0", color="#efcccc", fontcolor="#9b1c1c"];
    modelo [label="Modelo\nConsulta o modifica datos", fillcolor="#fff1f0", color="#efcccc", fontcolor="#9b1c1c"];
    conexion [label="Conexion y PDO"];
    base [shape=cylinder, style=filled, label="bdm_aseguradora\nMySQL / MariaDB", fillcolor="#eff6ff", color="#cddcf0"];
    vista [label="Vista PHP\nGenera HTML"];
    directa [label="JSON o multimedia\nChat y evidencias"];
    respuesta [label="Respuesta al navegador", fillcolor="#172033", fontcolor="white", color="#172033"];
    comunes [label="lib/\nUtilidades compartidas", fillcolor="#f4f3ff", color="#e1def3"];
    peticion -> entrada;
    entrada -> controlador;
    controlador -> modelo [dir=both];
    modelo -> conexion [dir=both];
    conexion -> base [dir=both];
    controlador -> vista;
    controlador -> directa;
    vista -> respuesta;
    directa -> respuesta;
    comunes -> controlador [style=dashed, constraint=false];
    comunes -> modelo [style=dashed, constraint=false];
    { rank=same; comunes; controlador; }
    { rank=same; vista; directa; modelo; }
}
